generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Configuração Global (Hub, IA, Automações e Integrações)
model ConfigSistema {
  id                     Int      @id @default(1)
  modoAtivo              String   @default("BARBEARIA") // "BARBEARIA" ou "CLINICA"
  
  // Gestão IA
  nomeAssistente         String   @default("Assistente Virtual")
  tomDeVoz               String   @default("Amigável e profissional")
  objetivos              String   @default("Agendar clientes e tirar dúvidas")
  regrasExtrasIA         String   @default("")
  faq                    String   @default("")
  ignorarDiagnosticos    Boolean  @default(false)
  regrasTransferencia    String   @default("Transferir se o cliente disser 'humano'")

  // Automações
  notificarNovosLeads    Boolean  @default(true)
  autoFollowUp           Boolean  @default(true)
  autoLembrete           Boolean  @default(true)
  distribuicaoLeads      String   @default("MANUAL") // MANUAL ou ROTATIVO
  
  // Integrações
  webhookUrl             String?
  metaToken              String?
  googleCalendarKey      String?
}

// Equipe
model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  senha        String
  funcao       String        @default("ATENDENTE") // ADMIN, ATENDENTE
  status       String        @default("OFFLINE")   // ONLINE, OFFLINE
  clientes     Cliente[]     // Leads vinculados a este usuário
  notas        NotaInterna[]
}

model Cliente {
  id               String        @id // Número do WhatsApp
  nome             String?
  falarHumano      Boolean       @default(false)
  criadoEm         DateTime      @default(now())
  
  // CRM Avançado
  leadStatus       String        @default("NOVO")
  origem           String        @default("WhatsApp")
  interesse        String?       
  valorPotencial   Float         @default(0.0)
  observacoes      String?
  tags             String?       // Tags separadas por vírgula
  ultimaInteracao  DateTime      @default(now())
  
  responsavelId    Int?
  responsavel      Usuario?      @relation(fields: [responsavelId], references: [id])
  
  mensagensIA      MensagemIA[]
  agendamentos     Agendamento[]
  notasInternas    NotaInterna[]
}

// Histórico de Notas Internas do Chat
model NotaInterna {
  id        Int      @id @default(autoincrement())
  texto     String
  criadoEm  DateTime @default(now())
  
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

model MensagemIA {
  id        Int      @id @default(autoincrement())
  role      String   
  content   String
  criadoEm  DateTime @default(now())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
}

model Servico {
  id           Int           @id @default(autoincrement())
  nome         String
  preco        Float
  duracaoMin   Int
  agendamentos Agendamento[]
}

model Barbeiro {
  id           Int           @id @default(autoincrement())
  nome         String
  agendamentos Agendamento[]
}

model Tratamento {
  id           Int           @id @default(autoincrement())
  nome         String
  preco        Float
  duracaoMin   Int
  descricao    String?
  agendamentos Agendamento[]
}

model ProfissionalSaude {
  id           Int           @id @default(autoincrement())
  nome         String
  especialidade String
  agendamentos Agendamento[]
}

model Agendamento {
  id                  Int       @id @default(autoincrement())
  dataHora            DateTime
  status              String    @default("AGENDADO") // AGENDADO, CONCLUIDO, CANCELADO, REMARCADO, AVALIADO
  criadoEm            DateTime  @default(now())
  
  clienteId           String
  cliente             Cliente   @relation(fields: [clienteId], references: [id])
  
  servicoId           Int?
  servico             Servico?  @relation(fields: [servicoId], references: [id])
  barbeiroId          Int?
  barbeiro            Barbeiro? @relation(fields: [barbeiroId], references: [id])
  
  tratamentoId        Int?
  tratamento          Tratamento? @relation(fields: [tratamentoId], references: [id])
  profissionalSaudeId Int?
  profissionalSaude   ProfissionalSaude? @relation(fields: [profissionalSaudeId], references: [id])
}