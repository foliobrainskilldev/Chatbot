generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Configuração Global do Painel (Define se é Barbearia ou Clínica, e as regras da IA)
model ConfigSistema {
  id                     Int      @id @default(1)
  modoAtivo              String   @default("BARBEARIA") // "BARBEARIA" ou "CLINICA"
  nomeAssistente         String   @default("Assistente Virtual")
  tomDeVoz               String   @default("Amigável e profissional")
  regrasExtrasIA         String   @default("")
  ignorarDiagnosticos    Boolean  @default(true) // Regra estrita para clínicas
  notificarNovosLeads    Boolean  @default(true)
  mensagemSaudacao       String   @default("Olá! Como posso ajudar hoje?")
}

model Cliente {
  id               String        @id // Número do WhatsApp
  nome             String?
  falarHumano      Boolean       @default(false)
  criadoEm         DateTime      @default(now())
  
  // Novos campos para o CRM Avançado
  leadStatus       String        @default("NOVO") // NOVO, QUALIFICADO, AGENDADO, PERDIDO
  origem           String        @default("WhatsApp")
  interesse        String?       // Qual serviço/tratamento demonstrou interesse
  valorPotencial   Float         @default(0.0)
  observacoes      String?
  tags             String?       // Ex: "urgente, paciente_recorrente"
  ultimaInteracao  DateTime      @default(now())
  
  mensagensIA      MensagemIA[]
  agendamentos     Agendamento[]
}

model MensagemIA {
  id        Int      @id @default(autoincrement())
  role      String   
  content   String
  criadoEm  DateTime @default(now())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
}

// --- DADOS DA BARBEARIA (Mantidos intactos) ---
model Servico {
  id           Int           @id @default(autoincrement())
  nome         String
  preco        Float
  duracaoMin   Int
  agendamentos Agendamento[]
}

model Barbeiro {
  id           Int           @id @default(autoincrement())
  nome         String
  agendamentos Agendamento[]
}

// --- DADOS DA CLÍNICA (Novos) ---
model Tratamento {
  id           Int           @id @default(autoincrement())
  nome         String
  preco        Float
  duracaoMin   Int
  descricao    String?
  agendamentos Agendamento[]
}

model ProfissionalSaude {
  id           Int           @id @default(autoincrement())
  nome         String
  especialidade String
  agendamentos Agendamento[]
}

// --- AGENDAMENTO UNIFICADO ---
model Agendamento {
  id                  Int       @id @default(autoincrement())
  dataHora            DateTime
  status              String    @default("AGENDADO") // AGENDADO, CONCLUIDO, CANCELADO, AVALIADO
  criadoEm            DateTime  @default(now())
  
  clienteId           String
  cliente             Cliente   @relation(fields: [clienteId], references: [id])
  
  // Relações Opcionais (Depende do Modo Ativo)
  servicoId           Int?
  servico             Servico?  @relation(fields: [servicoId], references: [id])
  barbeiroId          Int?
  barbeiro            Barbeiro? @relation(fields: [barbeiroId], references: [id])
  
  tratamentoId        Int?
  tratamento          Tratamento? @relation(fields: [tratamentoId], references: [id])
  profissionalSaudeId Int?
  profissionalSaude   ProfissionalSaude? @relation(fields: [profissionalSaudeId], references: [id])
}