// --- START OF FILE schema.prisma ---

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConfigSistema {
  id                  Int     @id @default(1)
  modoAtivo           String  @default("BARBEARIA")
  
  // Identidade
  nomeClinica         String  @default("Clínica Saúde Mais")
  nomeAssistente      String  @default("Assistente Ana")
  avatarUrl           String? @db.Text
  idioma              String  @default("Português (Brasil)")
  
  // Personalidade e Comunicação
  tomDeVoz            String  @default("Profissional e acolhedor")
  estiloComunicacao   String  @default("Respostas curtas e diretas")
  formalidade         String  @default("Tratar o paciente por Você")
  
  // Conhecimento e Limites
  objetivos           String? @db.Text
  permissoes          String? @db.Text
  regrasExtrasIA      String? @db.Text
  faq                 String? @db.Text
  
  // Transferência
  regrasTransferencia String? @db.Text
  msgTransferencia    String  @default("Vou encaminhar você para um de nossos atendentes. Aguarde um momento.")
  
  // Outros Setups Globais
  metaToken           String? @db.Text
  webhookUrl          String?
  notificarNovosLeads Boolean @default(true)
  ignorarDiagnosticos Boolean @default(true)
  autoFollowUp        Boolean @default(false)
  autoLembrete        Boolean @default(false)
  distribuicaoLeads   String  @default("MANUAL")
}

model LogAlteracaoIA {
  id        Int      @id @default(autoincrement())
  autor     String   @default("Administrador")
  descricao String   @db.Text
  criadoEm  DateTime @default(now())
}

model Usuario {
  id          Int           @id @default(autoincrement())
  nome        String
  email       String        @unique
  senha       String
  funcao      String        @default("ATENDENTE") 
  status      String        @default("ONLINE")
  notas       NotaInterna[]
  clientes    Cliente[]     @relation("ClienteResponsavel")
  criadoEm    DateTime      @default(now())
}

model Cliente {
  id                  String               @id // Número de telefone via Meta API
  nome                String?
  email               String?
  fotoUrl             String?              @db.Text 
  leadStatus          String               @default("NOVO") 
  falarHumano         Boolean              @default(false)
  tags                String?
  valorPotencial      Float                @default(0.0)
  origem              String               @default("WhatsApp Meta")
  observacoes         String?              @db.Text
  
  responsavelId       Int?
  responsavel         Usuario?             @relation("ClienteResponsavel", fields: [responsavelId], references: [id])

  ultimaInteracao     DateTime             @default(now())
  criadoEm            DateTime             @default(now())
  
  mensagens           MensagemIA[]
  agendamentos        Agendamento[]
  notas               NotaInterna[]
  
  // Relacionamentos do Motor de Automação
  filaAutomacoes      FilaAutomacao[]
  historicoAutomacoes AutomacaoHistorico[]
}

model MensagemIA {
  id              Int      @id @default(autoincrement())
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  role            String   
  content         String   @db.Text
  midiaUrl        String?  @db.Text 
  tipoMidia       String?  
  atendenteHumano Boolean  @default(false) 
  criadoEm        DateTime @default(now())
}

model Tratamento {
  id                Int                 @id @default(autoincrement())
  nome              String
  categoria         String?             @default("Outros")
  tipoPreco         String              @default("FIXO")
  preco             Float?
  duracaoMin        Int                 @default(30)
  descricaoCurta    String?             @db.Text
  descricaoCompleta String?             @db.Text
  informacoesIA     String?             @db.Text
  regrasIA          String?             @db.Text
  faq               String?             @db.Text
  podeAgendarIA     Boolean             @default(true)
  imagemUrl         String?             @db.Text 
  status            String              @default("ATIVO")
  criadoEm          DateTime            @default(now())
  agendamentos      Agendamento[]
  profissionais     ProfissionalSaude[] 
}

model ProfissionalSaude {
  id                 Int           @id @default(autoincrement())
  nome               String
  especialidade      String
  horaInicioTrabalho Int           @default(8)
  horaFimTrabalho    Int           @default(18)
  agendamentos       Agendamento[]
  tratamentos        Tratamento[]  
}

model Feriado {
  id        Int      @id @default(autoincrement())
  data      DateTime
  descricao String?
}

model Servico {
  id           Int           @id @default(autoincrement())
  nome         String
  preco        Float
  duracaoMin   Int           @default(30)
  agendamentos Agendamento[]
}

model Barbeiro {
  id           Int           @id @default(autoincrement())
  nome         String
  agendamentos Agendamento[]
}

model Agendamento {
  id                  Int                @id @default(autoincrement())
  dataHora            DateTime
  status              String             @default("AGENDADO") 
  clienteId           String
  cliente             Cliente            @relation(fields: [clienteId], references: [id])
  
  tratamentoId        Int?
  tratamento          Tratamento?        @relation(fields: [tratamentoId], references: [id])
  profissionalSaudeId Int?
  profissionalSaude   ProfissionalSaude? @relation(fields: [profissionalSaudeId], references: [id])
  
  servicoId           Int?
  servico             Servico?           @relation(fields: [servicoId], references: [id])
  barbeiroId          Int?
  barbeiro            Barbeiro?          @relation(fields: [barbeiroId], references: [id])
  
  observacoes         String?            @db.Text
  criadoEm            DateTime           @default(now())
  atualizadoEm        DateTime           @updatedAt
}

model NotaInterna {
  id        Int      @id @default(autoincrement())
  texto     String   @db.Text
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  criadoEm  DateTime @default(now())
}

model WebhookEndpoint {
  id        Int      @id @default(autoincrement())
  url       String   @db.Text
  secret    String?
  eventos   String   
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
}

// ----------------------------------------------------
// MODELOS DO MOTOR DE AUTOMAÇÕES E FLOWS
// ----------------------------------------------------

model Automacao {
  id        Int      @id @default(autoincrement())
  nome      String   @default("Nova Automação")
  gatilho   String
  condicoes String?  @db.Text
  acao      String
  parametro String?  @db.Text
  atraso    Int      @default(0) // Atraso em minutos (0 = Imediato)
  execucoes Int      @default(0) // Contador de vezes que rodou com sucesso
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  fila      FilaAutomacao[]
  historico AutomacaoHistorico[]
}

model FilaAutomacao {
  id           Int        @id @default(autoincrement())
  automacaoId  Int
  automacao    Automacao  @relation(fields: [automacaoId], references: [id], onDelete: Cascade)
  clienteId    String
  cliente      Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  dadosPayload String?    @db.Text
  dataAgendada DateTime   // Data exata em que o cron job deve executar a regra
  status       String     @default("AGUARDANDO") // AGUARDANDO, PROCESSANDO, CONCLUIDO
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
}

model AutomacaoHistorico {
  id           Int        @id @default(autoincrement())
  automacaoId  Int
  automacao    Automacao  @relation(fields: [automacaoId], references: [id], onDelete: Cascade)
  clienteId    String
  cliente      Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  dataExecucao DateTime   @default(now())
  resultado    String     // SUCESSO ou FALHA
  detalhes     String?    @db.Text
}